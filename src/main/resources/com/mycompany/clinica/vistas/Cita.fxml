<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="700.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.clinica.controlador.CitaController">
   <children>
      <Label text="Citas" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <HBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="70.0">
         <children>
            <VBox prefWidth="250.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Paciente" textFill="#555555" />
                        <ComboBox fx:id="cmbPaciente" maxWidth="1.7976931348623157E308" promptText="Seleccionar Paciente" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dcdcdc;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Doctor" textFill="#555555" />
                        <ComboBox fx:id="cmbDoctor" maxWidth="1.7976931348623157E308" promptText="Seleccionar Doctor" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dcdcdc;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Fecha" textFill="#555555" />
                        <DatePicker fx:id="dpFecha" maxWidth="1.7976931348623157E308" promptText="Seleccionar Fecha" style="-fx-background-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Hora" textFill="#555555" />
                        <TextField fx:id="txtHora" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dcdcdc;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Estado" textFill="#555555" />
                        <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308" promptText="Pendiente/Completada" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #dcdcdc;" />
                     </children>
                  </VBox>
                  
                  <HBox spacing="10.0">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <children>
                        <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Guardar" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnLimpiar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Limpiar" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <Button fx:id="btnEliminar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Eliminar" />
               </children>
            </VBox>
            
            <TableView fx:id="tablaCitas" style="-fx-background-radius: 8; -fx-border-radius: 8;" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colId" prefWidth="40.0" text="ID" />
                <TableColumn fx:id="colPaciente" prefWidth="130.0" text="Paciente" />
                  <TableColumn fx:id="colDoctor" prefWidth="130.0" text="Doctor" />
                  <TableColumn fx:id="colFecha" prefWidth="90.0" text="Fecha" />
                  <TableColumn fx:id="colHora" prefWidth="60.0" text="Hora" />
                  <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </HBox>
   </children>
</AnchorPane>
