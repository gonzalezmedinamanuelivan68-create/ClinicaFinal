<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="panelPrincipal" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.clinica.controlador.MainDashboardController">
   
   <left>
      <VBox prefWidth="200.0" spacing="10.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Clínica Médica" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="30.0" left="20.0" top="30.0" />
               </VBox.margin>
            </Label>
            
            <Button fx:id="btnPacientes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px;" text="Pacientes">
               <padding>
                  <Insets bottom="15.0" left="20.0" top="15.0" />
               </padding>
            </Button>
            
            <Button fx:id="btnDoctores" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px;" text="Doctores">
               <padding>
                  <Insets bottom="15.0" left="20.0" top="15.0" />
               </padding>
            </Button>
            
            <Button fx:id="btnCitas" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px;" text="Citas">
               <padding>
                  <Insets bottom="15.0" left="20.0" top="15.0" />
               </padding>
            </Button>
            
            <Button fx:id="btnConsultas" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px;" text="Consultas">
               <padding>
                  <Insets bottom="15.0" left="20.0" top="15.0" />
               </padding>
            </Button>
            <Button fx:id="btnAdministradores" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-font-size: 14px;" text="Administrador">
               <padding>
                  <Insets bottom="15.0" left="20.0" top="15.0" />
               </padding>
            </Button>
            
            <AnchorPane VBox.vgrow="ALWAYS" />
            
            <Button fx:id="btnCerrarSesion" maxWidth="1.7976931348623157E308" mnemonicParsing="false" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Cerrar Sesión">
               <VBox.margin>
                  <Insets bottom="20.0" left="15.0" right="15.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" top="10.0" />
               </padding>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contenedorPrincipal" style="-fx-background-color: #f4f4f4;" BorderPane.alignment="CENTER">
         <children>
            <Label text="HOLA" textFill="#7f8c8d">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </StackPane>
   </center>
</BorderPane>